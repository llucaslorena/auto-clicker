# Built application files
*.apk
*.ap_
*.aab
*.dex

# Files for the ART/Dalvik VM
*.class

# Java byte code cache
.java/

# Gradle files
.gradle/
build/
output-metadata.json

# Local configuration file (sdk path, passwords, local env)
local.properties

# Proguard / R8 folder generated by Eclipse or Gradle
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures and profiling
captures/
*.hprof

# IntelliJ IDEA / Android Studio project files
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files and certificates (SENSITIVE DATA)
*.jks
*.keystore
*.key
*.p12
*.pem

# External native build folder
.externalNativeBuild/
.cxx/

# Google Services (Firebase / Google APIs)
google-services.json

# OS generated files
.DS_Store
Thumbs.db
